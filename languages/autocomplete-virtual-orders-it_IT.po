#. Plugin Name of the plugin
#: autocomplete-virtual-orders.php
msgid "Autocomplete Virtual Orders"
msgstr "Autocomplete Virtual Orders"

#. Description of the plugin
#: autocomplete-virtual-orders.php
msgid "Automatically completes WooCommerce orders that contain only virtual items (nothing to ship) when they reach Processing."
msgstr "Completa automaticamente gli ordini WooCommerce che contengono solo articoli virtuali (niente da spedire) quando raggiungono lo stato “In elaborazione”."

#. Author of the plugin
#: autocomplete-virtual-orders.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. translators: Order note added when WooCommerce moves an order to its Completed status. %s is the plugin name, not translated.
#: includes/class-plugin.php:124
#, php-format
msgid "%s: order completed automatically (all items are virtual — nothing to ship)."
msgstr "%s: ordine completato automaticamente (tutti gli articoli sono virtuali — non c'è nulla da spedire)."


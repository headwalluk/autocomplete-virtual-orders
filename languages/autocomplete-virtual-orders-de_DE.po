#. Plugin Name of the plugin
#: autocomplete-virtual-orders.php
msgid "Autocomplete Virtual Orders"
msgstr "Automatische Vervollständigung virtueller Bestellungen"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: autocomplete-virtual-orders.php
msgid "https://headwall-hosting.com/"
msgstr "https://headwall-hosting.com/"

#. Description of the plugin
#: autocomplete-virtual-orders.php
msgid "Automatically completes WooCommerce orders that contain only virtual items (nothing to ship) when they reach Processing."
msgstr "Schließt WooCommerce-Bestellungen, die ausschließlich virtuelle Artikel enthalten (keine Versandware), automatisch ab, sobald sie den Status „In Bearbeitung“ erreichen."

#. Author of the plugin
#: autocomplete-virtual-orders.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. translators: %s is the plugin name, used as a prefix on the order note; not translated.
#: includes/class-plugin.php:94
#, php-format
msgid "%s: order completed automatically (all items are virtual — nothing to ship)."
msgstr "%s: Bestellung wurde automatisch abgeschlossen (alle Artikel sind virtuell – es gibt nichts zu versenden)."
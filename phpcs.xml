<?xml version="1.0"?>
<ruleset name="Autocomplete Virtual Orders">
	<description>WordPress Coding Standards for the Autocomplete Virtual Orders plugin</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude patterns -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dev-notes/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/> <!-- Show sniff and progress -->
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Rules: WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>

		<!-- We use namespaces, so we don't need prefixes on everything -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>

		<!-- Allow unused parameters in hook callbacks (required by WordPress hook signatures) -->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	</rule>

	<!-- Enforce WordPress naming conventions for hooks and global functions -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="autocomplete_virtual_orders"/>
				<element value="acvo"/>
			</property>
		</properties>
	</rule>
</ruleset>
